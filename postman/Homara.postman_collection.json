        {
          "name": "Consultar carrito y totales",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 con success true\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.test(\"Los totales son coherentes\", () => {",
                  "  const c = pm.response.json().data;",
                  "  const subtotal = c.items.reduce((s, i) => s + i.product.price * i.quantity, 0);",
                  "  pm.expect(c.subtotal).to.eql(subtotal);",
                  "  pm.expect(c.total).to.eql(c.subtotal + c.shipping);",
                  "  const item = c.items.find((i) => i.product.id === pm.collectionVariables.get(\"productoId\"));",
                  "  pm.expect(item, \"el producto agregado está en el carrito\").to.exist;",
                  "  pm.collectionVariables.set(\"itemId\", item.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart"
              ]
            },
            "description": "Objetivo: subtotal = Σ precio × cantidad y total = subtotal + envío (RN-029, RN-032). Esperado: 200 y totales coherentes."
          }
