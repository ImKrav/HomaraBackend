        {
          "name": "Modificar cantidad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 con success true\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.test(\"La cantidad quedó en 2\", () => pm.expect(pm.response.json().data.quantity).to.eql(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
