                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.test(\"Guarda el token del cliente\", () => {",
                  "  const t = pm.response.json().data.token;",
                  "  pm.expect(t.split(\".\")).to.have.lengthOf(3);",
