            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correoNuevo}}\",\n  \"password\": \"{{claveNueva}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"QA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
