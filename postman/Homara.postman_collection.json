{
  "info": {
    "name": "Homara API",
    "description": "Pruebas de la API de Homara por módulo, con casos positivos y negativos. Cada petición documenta su objetivo y resultado esperado; las pruebas se amplían con Postbot (ver postman/README.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Autenticación (ESC01, ESC02, ESC04, ESC35)",
      "item": [
        {
          "name": "Registrar usuario nuevo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"correoNuevo\", \"postman.\" + Date.now() + \"@homara.co\");",
                  "// Clave generada en cada corrida (sin contraseñas literales en el repositorio).",
                  "pm.collectionVariables.set(\"claveNueva\", \"Pm-\" + Date.now() + \"-\" + Math.random().toString(36).slice(2, 8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 con success true\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "pm.test(\"Devuelve token y rol CUSTOMER sin contraseña\", () => {",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.token).to.be.a(\"string\");",
                  "  pm.expect(d.user.role).to.eql(\"CUSTOMER\");",
                  "  pm.expect(d.user).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correoNuevo}}\",\n  \"password\": \"{{claveNueva}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"QA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "description": "Objetivo: registrar un cliente con datos válidos (RN-001, RN-002). Esperado: 201, token y rol CUSTOMER, sin contraseña en la respuesta."
          }
        },
        {
          "name": "Registrar correo duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
